# Vietnamese Food Taste App - Web Environment Variables

# Backend API Base URL
# - Development: Leave empty to use Vite dev proxy (/api -> http://localhost:3000)
# - Production: Set to your backend API domain (e.g., https://api.yourdomain.com)
#   Or leave empty if deploying behind a reverse proxy/rewrite (e.g., Nginx, Cloudflare, Vercel)
VITE_API_URL=

# Target backend port/host for Vite dev server proxy (defaults to http://localhost:3000)
VITE_API_BACKEND_TARGET=http://localhost:3000
