# ──────────────────────────────────────────────────────────────
# Vietnamese Food Taste App - Root Environment Variables Example
# ──────────────────────────────────────────────────────────────

# ── Backend Configuration (@vft/api) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vft_dev
PORT=3000
NODE_ENV=development
# CORS Origin(s) allowed - can be single origin or comma-separated list
CORS_ORIGIN=http://localhost:5173

# Secret keys (Replace with strong random strings in Production)
JWT_SECRET=super-secret-jwt-key-change-in-production
PHONE_SECRET=super-secret-phone-hmac-key

# Google Gemini AI API Key (for taste preference analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend Configuration (@vft/web) ──
# - Leave empty in Development to use Vite dev proxy (/api -> http://localhost:3000)
# - In Production, set to your deployed backend URL (e.g. https://api.yourdomain.com)
VITE_API_URL=
VITE_API_BACKEND_TARGET=http://localhost:3000
